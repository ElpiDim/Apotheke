  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://peanut-api-staging.elpida-el-dimitriadou.workers.dev; frame-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
